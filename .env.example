# BDS WF 2026 - environment template
# Copy to .env and replace every `change-me`/`replace-with` value. Never commit real credentials.

# Runtime
APP_MODE=production
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080
APP_BASE_URL=https://nhadatchuan.online
API_INTERNAL_URL=http://backend:8080
VITE_PUBLIC_API_BASE_URL=/api/v1
APP_LOG_LEVEL=INFO
SPRINGDOC_API_DOCS_ENABLED=false

# PostgreSQL
POSTGRES_DB=bds
POSTGRES_USER=bds
POSTGRES_PASSWORD=replace-with-random-password-at-least-24-chars
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/bds
SPRING_DATASOURCE_USERNAME=bds
SPRING_DATASOURCE_PASSWORD=replace-with-the-same-postgres-password

# Redis
REDIS_PASSWORD=replace-with-random-password-at-least-24-chars
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace-with-the-same-redis-password

# MinIO private object storage
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=bds-listings
MINIO_ROOT_USER=bds-media
MINIO_ROOT_PASSWORD=replace-with-random-password-at-least-24-chars
APP_MEDIA_STORAGE_ENABLED=true
APP_MEDIA_ALLOWED_HOSTS=nhadatchuan.online,www.nhadatchuan.online

# Antivirus, search and mail
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-with-smtp-account
SPRING_MAIL_PASSWORD=replace-with-smtp-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
SPRING_MAIL_STARTTLS_REQUIRED=true
SPRING_MAIL_TEST_CONNECTION=true
SPRING_MAIL_CONNECTION_TIMEOUT_MS=10000
SPRING_MAIL_TIMEOUT_MS=10000
SPRING_MAIL_WRITE_TIMEOUT_MS=10000
APP_MAIL_FROM=replace-with-verified-sender-address
APP_PUBLIC_BASE_URL=https://nhadatchuan.online

# Security (generate separate random values; examples are intentionally invalid)
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key
PII_INDEX_KEY=replace-with-different-base64-32-byte-key
APP_ADMIN_MFA_SECRET_BASE64=replace-with-base64-totp-secret
APP_ALLOWED_ORIGINS=https://nhadatchuan.online,https://www.nhadatchuan.online
DEMO_ACCOUNT_PASSWORD=replace-with-random-demo-password-at-least-16-chars
FEATURE_REAL_KYC=false
FEATURE_REAL_TRANSACTIONS=false

# Transactional outbox
OUTBOX_ENABLED=false
OUTBOX_WEBHOOK_URL=
OUTBOX_SIGNING_KEY=replace-before-enabling-outbox
OUTBOX_POLL_DELAY_MS=1000

# Optional production Compose overlay
PUBLIC_HOST=nhadatchuan.online
PGBOUNCER_USERLIST_FILE=C:/secure/bds/pgbouncer-userlist.txt

# Kubernetes metadata; Kubernetes runtime secrets come from Vault/External Secrets.
K8S_CONTEXT=kind-bds-production-local
K8S_NAMESPACE=bds
K8S_PUBLIC_HOST=nhadatchuan.online
