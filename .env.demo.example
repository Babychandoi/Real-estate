# Local demo only. All credentials below protect disposable sample data.
APP_MODE=demo
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
APP_BASE_URL=http://localhost:3000
APP_PUBLIC_BASE_URL=http://localhost:3000
APP_ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_DB=bds
POSTGRES_USER=bds
POSTGRES_PASSWORD=demo-postgres-2026-only
REDIS_PASSWORD=demo-redis-2026-only
MINIO_ROOT_USER=bds-demo-media
MINIO_ROOT_PASSWORD=demo-minio-2026-only
MINIO_BUCKET=bds-listings
DEMO_ACCOUNT_PASSWORD=demo-account-2026-only
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_STARTTLS_ENABLE=false
SPRING_MAIL_STARTTLS_REQUIRED=false
SPRING_MAIL_TEST_CONNECTION=false
APP_MAIL_FROM=no-reply@bds.local
APP_MEDIA_STORAGE_ENABLED=true
FEATURE_REAL_KYC=false
FEATURE_REAL_TRANSACTIONS=false
OUTBOX_ENABLED=false
APP_GEOCODING_CONTACT=demo@nhadatchuan.online
# CI/E2E: every browser project reaches the backend from the same client IP, so rate limits are scaled up here.
RATE_LIMIT_LIMIT_MULTIPLIER=20
# Search (stream S2): cursor HMAC key, required (>= 32 chars) and identical on every backend instance.
SEARCH_CURSOR_SECRET=demo-search-cursor-secret-2026-only-not-for-production
MEDIA_SIGNING_SECRET=demo-media-signing-secret-2026-only-not-for-production
APP_SEARCH_INDEX_REPLICAS=0
APP_SEARCH_TIMEOUT=PT0.8S
APP_SEARCH_BREAKER_OPEN_FOR=PT30S
APP_SEARCH_BOOTSTRAP_ON_STARTUP=true
APP_SEARCH_TRUST_EXPIRY_CRON=0 40 3 * * *
APP_SEARCH_CACHE_ENABLED=true
