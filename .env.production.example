# Production template. Replace every replace-with value through a secret manager.
APP_MODE=production
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080
APP_BASE_URL=https://nhadatchuan.online
APP_PUBLIC_BASE_URL=https://nhadatchuan.online
APP_ALLOWED_ORIGINS=https://nhadatchuan.online,https://www.nhadatchuan.online
POSTGRES_DB=bds
POSTGRES_USER=bds
POSTGRES_PASSWORD=replace-with-random-postgres-secret
REDIS_PASSWORD=replace-with-random-redis-secret
MINIO_ROOT_USER=bds-media-bootstrap
MINIO_ROOT_PASSWORD=replace-with-random-minio-root-secret
MINIO_BUCKET=bds-listings
DEMO_ACCOUNT_PASSWORD=replace-with-random-disabled-demo-secret
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key
PII_INDEX_KEY=replace-with-different-base64-32-byte-key
APP_ADMIN_MFA_SECRET_BASE64=replace-with-base64-totp-secret
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-with-smtp-account
SPRING_MAIL_PASSWORD=replace-with-smtp-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
SPRING_MAIL_STARTTLS_REQUIRED=true
SPRING_MAIL_TEST_CONNECTION=true
APP_MAIL_FROM=replace-with-verified-sender
APP_MEDIA_STORAGE_ENABLED=true
FEATURE_REAL_KYC=false
FEATURE_REAL_TRANSACTIONS=false
OUTBOX_ENABLED=true
OUTBOX_WEBHOOK_URL=replace-with-private-webhook-url
OUTBOX_SIGNING_KEY=replace-with-random-signing-secret
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
APP_GEOCODING_CONTACT=ops@nhadatchuan.online
