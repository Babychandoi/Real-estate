    {
      "type": "timeseries",
      "title": "Kết nối pool",
      "description": "Cảnh báo khi active/max > 80 % trong 5 phút hoặc có pending liên tục.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool) (hikaricp_connections_active{job=\"bds-backend\",instance=~\"$instance\"})",
          "legendFormat": "active {{pool}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool) (hikaricp_connections_idle{job=\"bds-backend\",instance=~\"$instance\"})",
          "legendFormat": "idle {{pool}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool) (hikaricp_connections_pending{job=\"bds-backend\",instance=~\"$instance\"})",
          "legendFormat": "pending {{pool}}",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pool) (hikaricp_connections_max{job=\"bds-backend\",instance=~\"$instance\"})",
          "legendFormat": "max {{pool}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "noValue": "Chưa có dữ liệu",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
