      "title": "Heap đã dùng / tối đa",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"bds-backend\",instance=~\"$instance\",area=\"heap\"})",
          "legendFormat": "đã dùng {{instance}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (jvm_memory_max_bytes{job=\"bds-backend\",instance=~\"$instance\",area=\"heap\"})",
          "legendFormat": "tối đa {{instance}}",
          "range": true
