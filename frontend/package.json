{
  "name": "bds-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --manifest",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:ui": "playwright test -c playwright.ui.config.ts",
    "preview:ui": "node scripts/preview-ui.mjs",
    "gen:api": "node scripts/gen-api-types.mjs",
    "check:api": "node scripts/gen-api-types.mjs --check"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.441.0",
    "maplibre-gl": "^6.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "^2.5.2",
    "uqr": "^0.1.3",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.55.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.10",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "1.55.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
