{
  "name": "Nhà Đất Chuẩn UI",
  "version": "2026-09-28",
  "source": [
    "frontend/tailwind.config.js",
    "frontend/app/styles/index.css"
  ],
  "description": "Documentation export; Tailwind/CSS remain runtime source of truth.",
  "colors": {
    "primary": "#00355f",
    "primaryHover": "#0f4c81",
    "onPrimary": "#ffffff",
    "secondary": "#006c4a",
    "surface": "#f8f9ff",
    "surfaceLowest": "#ffffff",
    "surfaceLow": "#eff4ff",
    "surfaceContainer": "#e5eeff",
    "text": "#0b1c30",
    "textSecondary": "#42474f",
    "border": "#dce3eb",
    "inputBorder": "#c2c7d1",
    "error": "#ba1a1a",
    "errorSurface": "#ffdad6",
    "onErrorSurface": "#93000a"
  },
  "typography": {
    "family": "Be Vietnam Pro",
    "fallback": "system-ui, sans-serif",
    "heroMobilePx": 30,
    "heroDesktopPx": 48,
    "sectionTitlePx": 24,
    "bodyPx": 16,
    "secondaryPx": 14,
    "captionPx": 12
