  "spacingPx": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "radiusPx": {
    "sm": 4,
    "default": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 16,
    "full": 9999
