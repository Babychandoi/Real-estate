  "layout": {
    "maxContentWidthPx": 1280,
    "headerMinHeightPx": 80,
    "controlMinHeightPx": 44,
    "gutterPx": {
      "mobile": 16,
      "tablet": 24,
      "desktop": 32
    },
    "listingColumns": {
      "base": 1,
      "sm": 2,
      "lg": 3
    },
    "breakpointsPx": {
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280
    },
    "reviewWidthsPx": [
      360,
      768,
      1024,
      1440
    ]
  },
  "focus": {
    "color": "#0f4c81",
    "widthPx": 3,
    "offsetPx": 3
  },
  "shadow": "0 12px 32px rgb(11 28 48 / 7%)"
